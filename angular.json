{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "lpshub-reports": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "lps",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "**/*", "input": "src/assets", "output": "assets" },
              { "glob": "**/*", "input": "design/LpsHub-Reports/assets", "output": "assets/brand" }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }], "outputHashing": "all" },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "development": { "buildTarget": "lpshub-reports:build:development" }, "production": { "buildTarget": "lpshub-reports:build:production" } }, "defaultConfiguration": "development" }
      }
    }
  },
  "cli": {
    "analytics": "d9f6432d-c919-4fad-ab0b-25bea2bf5714"
  }
}
