{
  "name": "lpshub-angular-reports",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./node_modules/@angular/cli/bin/ng.js serve",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build",
    "test": "node ./node_modules/@angular/cli/bin/ng.js test",
    "lint": "node ./node_modules/@angular/cli/bin/ng.js lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"docs/**/*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"docs/**/*.md\" \"*.json\""
  },
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.31",
    "prettier": "3.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0"
  }
}
